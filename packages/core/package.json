{
  "name": "@calendar-sdk/core",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "biome lint --config-path ../../biome.json ../../packages/core",
    "lint:fix": "biome lint --config-path ../../biome.json --write ../../packages/core",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.3.3"
  },
  "description": "Provider-agnostic TypeScript calendar SDK: one API for events, calendars, availability, sync, and webhooks across Google Calendar, Microsoft Graph, and CalDAV",
  "license": "MIT",
  "author": "Nandan Varma",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "calendar",
    "google-calendar",
    "microsoft-graph",
    "outlook",
    "caldav",
    "icloud",
    "ical",
    "scheduling",
    "availability",
    "sync",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/calendar-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nandan-varma/calendar-sdk#readme",
  "bugs": {
    "url": "https://github.com/nandan-varma/calendar-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
