{
  "name": "@calendar-sdk/google",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "biome lint --config-path ../../../biome.json ../../../packages/providers/google",
    "lint:fix": "biome lint --config-path ../../../biome.json --write ../../../packages/providers/google",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@calendar-sdk/core": "workspace:*"
  },
  "description": "Google Calendar provider adapter for calendar-sdk",
  "license": "MIT",
  "author": "Nandan Varma",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "calendar",
    "google-calendar",
    "microsoft-graph",
    "outlook",
    "caldav",
    "icloud",
    "ical",
    "scheduling",
    "availability",
    "sync",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/calendar-sdk.git",
    "directory": "packages/providers/google"
  },
  "homepage": "https://github.com/nandan-varma/calendar-sdk#readme",
  "bugs": {
    "url": "https://github.com/nandan-varma/calendar-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
