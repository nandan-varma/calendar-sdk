{
  "name": "calendar-sdk-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-provider calendar integration platform",
  "scripts": {
    "build": "pnpm -r run build",
    "build:watch": "pnpm -r run build -- --watch",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "test:watch": "pnpm -r run test:watch",
    "test:coverage": "pnpm --filter './packages/**' -r run test:coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "license": "MIT",
  "author": "Nandan Varma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/calendar-sdk.git"
  }
}
