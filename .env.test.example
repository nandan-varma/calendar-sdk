# Google Calendar API Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
# 1. Create a project
# 2. Enable Google Calendar API
# 3. Create OAuth 2.0 credentials (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft Graph API Credentials
# Get these from Azure Portal (https://portal.azure.com)
# 1. Register an application
# 2. Add Calendar.ReadWrite API permission
# 3. Create client secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# CalDAV Server Configuration
# Use any CalDAV server (iCloud, Nextcloud, self-hosted, etc.)
CALDAV_SERVER_URL=https://your-caldav-server.com
CALDAV_USERNAME=your-caldav-username
CALDAV_PASSWORD=your-caldav-password

# Test Account Configuration
TEST_ACCOUNT_EMAIL=test@example.com
TEST_WEBHOOK_URL=https://your-webhook-handler.com/webhook

# Optional: Integration Test Settings
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=80